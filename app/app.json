{
  "expo": {
    "name": "Trenfy",
    "slug": "trenfy",
    "scheme": "trenfy",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0F1E"
    },
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "app.trenfy",
      "buildNumber": "2"
    },
    "android": {
      "package": "app.trenfy",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0A0F1E"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/a59b8321-b0fb-47b7-a34f-25ad37d7f4a7"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-sqlite",
      "expo-updates",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "a59b8321-b0fb-47b7-a34f-25ad37d7f4a7"
      }
    }
  }
}
