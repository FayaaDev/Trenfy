      "id": "YOUTUBE_TRENDING_US",
      "name": "YouTube Trending - United States",
      "platform": "youtube",
      "endpoint": "videos.list",
      "params": {"chart": "mostPopular", "regionCode": "US", "part": "snippet,contentDetails,statistics"},
      "check_interval_minutes": 15,
      "enabled": true
    },
