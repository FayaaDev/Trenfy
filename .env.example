# NocoDB
NOCODB_BASE_ID=
NOCODB_API_TOKEN=
NOCODB_TRENDS_TABLE_ID=
NOCODB_SOURCES_TABLE_ID=
NOCODB_API_URL=https://nocodb.fayaa92.sa

# YouTube Data API v3
YOUTUBE_API_KEY=

# X API
X_BEARER_TOKEN=


# OpenRouter (future LLM trend analysis)
#OPENROUTER_API_KEY=
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Trenfy Settings
# Mockup mode (cost-saving demos): keep false to disable scheduler polling
# and avoid X/YouTube API traffic while using /api/trends/mockup.
TRENDS_ENABLED=false
SERVER_PORT=8080
LOG_LEVEL=info

# CORS — comma-separated list of additional allowed origins for production/staging
# http://localhost:5173 is always included. Example:
# CORS_ORIGINS=https://demo.example.com,https://admin.example.com
CORS_ORIGINS=
