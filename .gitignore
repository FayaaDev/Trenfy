# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
*.pyo
.mypy_cache/
.pytest_cache/

# Virtual environments
.venv/
.venv-workers/
python_modules/
venv/
ENV/
.wrangler/

# Environment files (secrets - NEVER commit these)
.env
.env.local
.env.*.local
*.env
!.env.example
!.env.test

# Application runtime data
app/findings/*.json
app/reports/*.pptx
app/reports/*.json
app/test-results/*.json

# Keep directory structure
!app/findings/.gitkeep
!app/reports/.gitkeep
!app/test-results/.gitkeep

# Logs
*.log
app/test-server.log

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Backups
*.backup
*.bak

# Test coverage
coverage/
.nyc_output/

# Temporary files
tmp/
temp/

# Dolt database files (added by bd init)
.dolt/
*.db

# bv (beads viewer) local config and caches
.bv/
